{
    "name": "@x-9lab/xlab",
    "version": "1.6.1",
    "description": "9lab 服务端模块",
    "versionDesc": "日志信息输出优化",
    "scripts": {
        "dev": "swc src --copy-files --strip-leading-paths --config-file .swcrc -d dist -w",
        "compile": "swc src --copy-files --strip-leading-paths --config-file .swcrc -d dist",
        "build": "yarn compile && yarn gen-declaration",
        "gen-declaration": "tsc --emitDeclarationOnly",
        "test": "node --test",
        "changelog": "changelog"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "main": "./dist/index.js",
    "types": "./@types/index.d.ts",
    "files": [
        "dist",
        "@types"
    ],
    "dependencies": {
        "@x-drive/utils": "1.1.32",
        "koa": "3.2.1",
        "koa-compress": "5.2.2",
        "koa-router": "14.0.0",
        "koa-static": "5.0.0",
        "liftoff": "5.0.1",
        "log4js": "^6.9.1",
        "minimist": "1.2.8"
    },
    "devDependencies": {
        "@swc/cli": "^0.7.7",
        "@swc/core": "^1.13.2",
        "@types/koa-router": "7.4.9",
        "@types/koa-static": "4.0.4",
        "@types/node": "^20.19.0",
        "@x-drive/changelog": "1.1.6",
        "chokidar": "^3.6.0",
        "typescript": "^5.9.2"
    },
    "bin": {
        "xlab": "dist/bin/xlab"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/x-9lab/xlab.git"
    }
}
